# BizListPlace frontend — copy to .env.local and fill in your own values.
# Nothing here is a secret; the API URL is public.

# Backend API (local dev)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Backend API (production, after the Render deploy — paste your Render URL)
# NEXT_PUBLIC_API_URL=https://<your-render-service>.onrender.com/api/v1
# Server-side API base used during static generation
INTERNAL_API_URL=http://127.0.0.1:5000/api/v1

# Public site URL
NEXT_PUBLIC_SITE_URL=https://bizlistplace.vercel.app

# WhatsApp support button — OPTIONAL. Digits only, country code, no +.
# Leave empty to hide the button. Never paste another project's number.
NEXT_PUBLIC_WHATSAPP_NUMBER=
