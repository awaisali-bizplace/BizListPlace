MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/bizlistplace?retryWrites=true&w=majority
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
USE_MEMORY_DB=false
JWT_SECRET=your-secure-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your-secure-cookie-secret-min-32-chars
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=bizlistplaceofficial@gmail.com
SMTP_PASS=your-gmail-16-char-app-password
SMTP_FROM_NAME=Biz List Place
SMTP_FROM_EMAIL=bizlistplaceofficial@gmail.com
ADMIN_EMAIL=bizlistplaceofficial@gmail.com

# Image uploads (Cloudinary) — OPTIONAL. Leave empty to disable uploads;
# the site then accepts image URLs instead. Use YOUR OWN Cloudinary
# account; never paste another project's keys here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Listing payments — OPTIONAL defaults only. Payments are OFF by default
# (isEnabled=false in the database). Set fees here only as a starting
# point; the admin panel overrides them. NEVER put an account number,
# IBAN, JazzCash/Easypaisa number or QR image here — add payment methods
# in the admin panel after the site is live.
PAYMENTS_ENABLED=false
PAYMENT_FEE_PKR=0
PAYMENT_FEE_AED=0
PAYMENT_FEE_USD=0

# WhatsApp support number (digits only, country code, no +) — optional,
# leave empty to hide the WhatsApp button.
WHATSAPP_NUMBER=

