{
  "name": "@bizlistplace/api",
  "version": "1.0.0",
  "description": "Express.js REST API for BizListPlace",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "clean": "tsx src/scripts/cleanDummy.ts",
    "test:email": "tsx src/scripts/testEmail.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@bizlistplace/shared": "*",
    "@types/compression": "^1.8.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^10.3.1",
    "sanitize-html": "^2.13.1",
    "slugify": "^1.6.6",
    "zod": "^3.24.2"
